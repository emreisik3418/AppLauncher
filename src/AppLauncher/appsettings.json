{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Urls": "http://localhost:5080",

  "Launcher": {
    "DataDirectory": "data",
    "TimeZone": "",
    "OutputEncoding": "utf-8",
    "HistoryLimit": 500,
    "CheckIntervalSeconds": 5,
    "StartupDelaySeconds": 30,

    "ErrorDetection": {
      "Patterns": [
        "\\b(ERR|ERROR|FATAL|CRITICAL)\\b",
        "\\b\\w+Exception\\b",
        "\\bUnhandled exception\\b",
        "\\bTraceback \\(most recent call last\\)"
      ],
      "IgnorePatterns": [ "\\b0 (errors?|hata)\\b" ],
      "IgnoreCase": true,
      "StdErrIsError": true
    },

    "Auth": {
      "Enabled": true,
      "AllowedUsers": [],
      "AllowedGroups": [],
      "Domain": "",
      "AllowPasswordLogin": true,
      "AllowWindowsLogin": true,
      "SessionMinutes": 480,
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 10
    }
  }
}
