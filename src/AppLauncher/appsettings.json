{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Urls": "http://localhost:5080",

  "Launcher": {
    "DataDirectory": "data",
    "TimeZone": "",
    "OutputEncoding": "utf-8",
    "HistoryLimit": 500,
    "CheckIntervalSeconds": 15,

    "Auth": {
      "Enabled": true,
      "AllowedUsers": [],
      "AllowedGroups": [],
      "Domain": "",
      "AllowPasswordLogin": true,
      "AllowWindowsLogin": true,
      "SessionMinutes": 480,
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 10
    }
  }
}
